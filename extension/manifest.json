{
  "manifest_version": 3,
  "name": "WA Campaign Scheduler – Sender",
  "version": "1.0.0",
  "description": "Sends your scheduled WhatsApp messages through your own logged-in WhatsApp Web tab, with safe delays and a daily cap.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "WA Campaign Scheduler" },
  "icons": { "128": "icon128.png" }
}
